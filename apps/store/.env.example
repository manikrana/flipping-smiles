# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — photo cartoonization + scene generation
GOOGLE_GEMINI_API_KEY=

# Stripe — checkout payment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend) — order confirmation on payment success
RESEND_API_KEY=

# Studio app — triggers page/PDF generation once an order is paid.
# Must match FULFILLMENT_WEBHOOK_SECRET in apps/studio's env.
STUDIO_APP_URL=
FULFILLMENT_WEBHOOK_SECRET=

# Gelato shipping webhook — registered as .../api/webhooks/gelato?secret=<this>
# in the Gelato dashboard for this store, so only Gelato (and us) know the URL.
GELATO_WEBHOOK_SECRET=
